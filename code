type InterviewStage =
  | "opening"
  | "technical_core"
  | "adaptive_deep_dive"
  | "behavioral_scenario"
  | "wrap_up";

type SessionStatus = "in_progress" | "paused" | "completed";
type VoicePersona = "Kore" | "Zephyr" | "Puck" | "Charon" | "Fenrir";

interface RoleTemplate {
  id: string;
  title: string;
  department: string;
  seniority: "Mid-Level" | "Senior" | "Staff";
  summary: string;
  competencies: string[];
  seedQuestions: string[];
}

interface TranscriptEntry {
  id: string;
  speaker: "interviewer" | "candidate";
  text: string;
  timestamp: string;
  stage: InterviewStage;
  interrupted?: boolean;
}

interface CompetencyScore {
  competency: string;
  score: number;
  rationale: string;
  evidenceQuote: string;
}

interface QuestionReview {
  topic: string;
  candidateSummary: string;
  depthRating: "Strong" | "Adequate" | "Shallow";
  followUpEffectiveness: string;
}

interface CandidateEvaluation {
  generatedAt: string;
  overallScore: number;
  recommendation: "Strong Hire" | "Hire" | "Lean Hire" | "No Hire";
  executiveSummary: string;
  competencyScores: CompetencyScore[];
  strengths: string[];
  concerns: string[];
  questionBreakdown: QuestionReview[];
  nextRoundFocus: string[];
}

interface InterviewSession {
  id: string;
  candidateName: string;
  roleId: string;
  roleTitle: string;
  seniority: string;
  voiceName: VoicePersona;
  status: SessionStatus;
  currentStage: InterviewStage;
  adaptationNotes: string[];
  interruptionCount: number;
  resumeCount: number;
  elapsedSeconds: number;
  createdAt: string;
  updatedAt: string;
  transcript: TranscriptEntry[];
  evaluation: CandidateEvaluation | null;
}

interface StoreFile {
  roles: RoleTemplate[];
  sessions: InterviewSession[];
}

