const STORE_FILE = path.resolve(process.cwd(), "interviews_store.json");

function loadStore(): StoreFile {
  if (!fs.existsSync(STORE_FILE)) {
    const initial: StoreFile = { roles: DEFAULT_ROLES, sessions: [] };
    fs.writeFileSync(STORE_FILE, JSON.stringify(initial, null, 2), "utf-8");
    return initial;
  }
  try {
    const parsed = JSON.parse(
      fs.readFileSync(STORE_FILE, "utf-8")
    ) as Partial<StoreFile>;
    return {
      roles:
        Array.isArray(parsed.roles) && parsed.roles.length > 0
          ? parsed.roles
          : DEFAULT_ROLES,
      sessions: Array.isArray(parsed.sessions) ? parsed.sessions : [],
    };
  } catch {
    return { roles: DEFAULT_ROLES, sessions: [] };
  }
}

function saveStore(store: StoreFile): void {
  fs.writeFileSync(STORE_FILE, JSON.stringify(store, null, 2), "utf-8");
}

