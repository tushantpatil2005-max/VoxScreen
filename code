  <script>
    let currentSession = null;
    let ws = null;
    let inputCtx = null;
    let outputCtx = null;
    let mediaStream = null;
    let processor = null;
    let outputAnalyser = null;
    let inputAnalyser = null;
    let nextStartTime = 0;
    let activeSources = new Set();
    let isMuted = false;
    let elapsedSeconds = 0;
    let timerId = null;

    const el = (id) => document.getElementById(id);

    function resampleTo16kPcmBase64(input, rate) {
      const target = 16000;
      const ratio = rate / target;
      const outLen = Math.max(1, Math.floor(input.length / ratio));
      const pcm = new Int16Array(outLen);
      for (let i = 0; i < outLen; i++) {
        const idx = Math.floor(i * ratio);
        const s = Math.max(-1, Math.min(1, input[idx] || 0));
        pcm[i] = s < 0 ? s * 0x8000 : s * 0x7fff;
      }
      const bytes = new Uint8Array(pcm.buffer);
      let bin = "";
      for (let i = 0; i < bytes.length; i += 0x8000) {
        bin += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
      }
      return btoa(bin);
    }

    function stopPlayback() {
      for (const src of activeSources) { try { src.stop(); } catch {} }
      activeSources.clear();
      nextStartTime = outputCtx ? outputCtx.currentTime : 0;
    }

    function playPcm24k(b64) {
      if (!outputCtx || !outputAnalyser) return;
      if (outputCtx.state === "suspended") outputCtx.resume();
      const bin = atob(b64);
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      const view = new DataView(bytes.buffer);
      const floats = new Float32Array(Math.floor(bytes.byteLength / 2));
      for (let i = 0; i < floats.length; i++) floats[i] = view.getInt16(i * 2, true) / 32768;
      const buf = outputCtx.createBuffer(1, floats.length, 24000);
      buf.copyToChannel(floats, 0);
      const src = outputCtx.createBufferSource();
      src.buffer = buf;
      src.connect(outputAnalyser);
      const startAt = Math.max(outputCtx.currentTime, nextStartTime);
      src.start(startAt);
      nextStartTime = startAt + buf.duration;
      activeSources.add(src);
      src.onended = () => activeSources.delete(src);
    }

    function teardown() {
      stopPlayback();
      clearInterval(timerId);
      if (processor) { processor.disconnect(); processor = null; }
      if (mediaStream) { mediaStream.getTracks().forEach((t) => t.stop()); mediaStream = null; }
      if (inputCtx) { inputCtx.close(); inputCtx = null; }
      if (outputCtx) { outputCtx.close(); outputCtx = null; }
      if (ws) { ws.close(); ws = null; }
    }

    function appendTurn(entry) {
      const div = document.createElement("div");
      div.className = "turn";
      div.innerHTML = '<div class="meta"><strong>' +
        (entry.speaker === "interviewer" ? "Interviewer" : currentSession.candidateName) +
        (entry.interrupted ? " (interrupted)" : "") +
        '</strong><span class="mono">' + new Date(entry.timestamp).toLocaleTimeString() + '</span></div>' +
        '<div>' + entry.text.replace(/</g, "&lt;") + '</div>';
      el("transcriptBox").appendChild(div);
      el("transcriptBox").scrollTop = el("transcriptBox").scrollHeight;
    }

    async function connectLive(session, isResume) {
      teardown();
      currentSession = session;
      elapsedSeconds = session.elapsedSeconds || 0;
      el("livePanel").style.display = "grid";
      el("liveHeader").textContent = session.candidateName + " — " + session.roleTitle;
      el("stageLabel").textContent = "Stage: " + session.currentStage;
      el("transcriptBox").innerHTML = "";
      (session.transcript || []).forEach(appendTurn);
      el("statusText").textContent = "Connecting...";

      outputCtx = new AudioContext({ sampleRate: 24000 });
      outputAnalyser = outputCtx.createAnalyser();
      outputAnalyser.connect(outputCtx.destination);
      nextStartTime = outputCtx.currentTime;

      try {
        mediaStream = await navigator.mediaDevices.getUserMedia({ audio: true });
        inputCtx = new AudioContext({ sampleRate: 16000 });
        const src = inputCtx.createMediaStreamSource(mediaStream);
        inputAnalyser = inputCtx.createAnalyser();
        processor = inputCtx.createScriptProcessor(4096, 1, 1);
        src.connect(inputAnalyser);
        inputAnalyser.connect(processor);
        processor.connect(inputCtx.destination);
      } catch {
        el("statusText").textContent = "Mic unavailable (keyboard mode)";
      }

      const proto = location.protocol === "https:" ? "wss:" : "ws:";
      ws = new WebSocket(proto + "//" + location.host + "/ws/interview");
      ws.onopen = () => ws.send(JSON.stringify({ type: "start", sessionId: session.id, resume: isResume }));
      ws.onmessage = (e) => {
        const msg = JSON.parse(e.data);
        if (msg.type === "ready") {
          el("statusText").textContent = "Live";
          el("pauseBtn").style.display = "";
          el("resumeBtn").style.display = "none";
          timerId = setInterval(() => {
            elapsedSeconds++;
            const m = String(Math.floor(elapsedSeconds / 60)).padStart(2, "0");
            const s = String(elapsedSeconds % 60).padStart(2, "0");
            el("timerLabel").textContent = m + ":" + s;
          }, 1000);
          if (processor && inputCtx) {
            const sr = inputCtx.sampleRate;
            processor.onaudioprocess = (ev) => {
              if (isMuted || !ws || ws.readyState !== 1) return;
              const b64 = resampleTo16kPcmBase64(ev.inputBuffer.getChannelData(0), sr);
              ws.send(JSON.stringify({ type: "audio", audio: b64 }));
            };
          }
        } else if (msg.type === "audio") {
          playPcm24k(msg.audio);
        } else if (msg.type === "transcript_committed") {
          appendTurn(msg.entry);
        } else if (msg.type === "interrupted") {
          stopPlayback();
          el("statusText").textContent = "Interrupted — Listening";
        } else if (msg.type === "stage_updated") {
          el("stageLabel").textContent = "Stage: " + msg.stage;
        } else if (msg.type === "error") {
          el("statusText").textContent = "Error: " + msg.message;
        }
      };
    }

    async function refreshData() {
      const [rolesRes, sessRes] = await Promise.all([fetch("/api/roles"), fetch("/api/sessions")]);
      const { roles } = await rolesRes.json();
      const { sessions } = await sessRes.json();
      el("roleSelect").innerHTML = roles.map((r) => '<option value="' + r.id + '">' + r.title + '</option>').join("");
      if (!sessions.length) {
        el("sessionsList").textContent = "No saved sessions yet.";
        return;
      }
      el("sessionsList").innerHTML = sessions.map((s) =>
        '<div class="row" style="justify-content:space-between;padding:8px 0;border-bottom:1px solid #f1f5f9">' +
        '<div><strong>' + s.candidateName + '</strong> — ' + s.roleTitle + ' (' + s.status + ', ' + s.transcript.length + ' turns)</div>' +
        '<div class="row">' +
        (s.status === "paused" ? '<button onclick="resumeSaved(\\'' + s.id + '\\')">Resume</button>' : '') +
        '<button onclick="viewSaved(\\'' + s.id + '\\')">View</button></div></div>'
      ).join("");
    }

    window.resumeSaved = async (id) => {
      const res = await fetch("/api/sessions/" + id);
      const { session } = await res.json();
      connectLive(session, true);
    };

    window.viewSaved = async (id) => {
      const res = await fetch("/api/sessions/" + id);
      const { session } = await res.json();
      currentSession = session;
      el("reportPanel").style.display = "block";
      el("reportOutput").textContent = JSON.stringify(session, null, 2);
    };

    el("startBtn").onclick = async () => {
      const name = el("candidateName").value.trim();
      if (!name) return;
      const res = await fetch("/api/sessions", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          candidateName: name,
          roleId: el("roleSelect").value,
          seniority: el("senioritySelect").value,
          voiceName: el("voiceSelect").value
        })
      });
      const { session } = await res.json();
      await refreshData();
      connectLive(session, false);
    };

    el("muteBtn").onclick = () => {
      isMuted = !isMuted;
      el("muteBtn").textContent = isMuted ? "Unmute Mic" : "Mute Mic";
    };
    el("interruptBtn").onclick = () => {
      stopPlayback();
      if (ws && ws.readyState === 1) ws.send(JSON.stringify({ type: "manual_interrupt" }));
    };
    el("pauseBtn").onclick = async () => {
      if (ws && ws.readyState === 1) ws.send(JSON.stringify({ type: "pause", elapsedSeconds }));
      teardown();
      el("statusText").textContent = "Paused";
      el("pauseBtn").style.display = "none";
      el("resumeBtn").style.display = "";
      await refreshData();
    };
    el("resumeBtn").onclick = () => currentSession && window.resumeSaved(currentSession.id);
    el("sendTextBtn").onclick = () => {
      const txt = el("textFallback").value.trim();
      if (!txt || !ws || ws.readyState !== 1) return;
      stopPlayback();
      ws.send(JSON.stringify({ type: "text", text: txt }));
      el("textFallback").value = "";
    };
    el("finishBtn").onclick = async () => {
      if (!currentSession) return;
      if (ws && ws.readyState === 1) ws.send(JSON.stringify({ type: "finish", elapsedSeconds }));
      teardown();
      el("statusText").textContent = "Evaluating...";
      const res = await fetch("/api/sessions/" + currentSession.id + "/evaluate", { method: "POST" });
      const data = await res.json();
      el("reportPanel").style.display = "block";
      el("reportOutput").textContent = JSON.stringify(data, null, 2);
      el("statusText").textContent = res.ok ? "Completed" : "Evaluation error";
      await refreshData();
    };
    el("downloadReportBtn").onclick = () => {
      if (!currentSession) return;
      const blob = new Blob([el("reportOutput").textContent], { type: "application/json" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = currentSession.id + "_report.json";
      a.click();
    };

    (function drawLoop() {
      const c = el("waveform");
      const ctx = c.getContext("2d");
      const bins = new Uint8Array(64);
      function frame() {
        if (c.width !== c.clientWidth) { c.width = c.clientWidth || 400; c.height = 110; }
        ctx.clearRect(0, 0, c.width, c.height);
        const activeAnalyser = activeSources.size > 0 ? outputAnalyser : inputAnalyser;
        if (activeAnalyser) activeAnalyser.getByteFrequencyData(bins); else bins.fill(0);
        const count = 40;
        const w = (c.width - (count - 1) * 4) / count;
        ctx.fillStyle = activeSources.size > 0 ? "#1d4ed8" : "#15803d";
        for (let i = 0; i < count; i++) {
          const h = Math.max(3, (bins[i + 1] / 255) * 90);
          ctx.fillRect(i * (w + 4), (110 - h) / 2, w, h);
        }
        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    })();

    refreshData();
  </script>
</body>
</html>`;

