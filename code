function buildSystemPrompt(
  session: InterviewSession,
  role: RoleTemplate,
  isResume: boolean
): string {
  const priorTranscript = session.transcript
    .map(
      (entry) =>
        `[${entry.stage}] ${
          entry.speaker === "interviewer" ? "Interviewer" : session.candidateName
        }${entry.interrupted ? " (interrupted)" : ""}: ${entry.text}`
    )
    .join("\n");

  return [
    `You are conducting a structured voice screening interview for ${role.title} (${session.seniority}, ${role.department}).`,
    `Candidate: ${session.candidateName}.`,
    `Role focus: ${role.summary}`,
    `Competencies to evaluate: ${role.competencies.join(", ")}.`,
    `Seed question themes (adapt freely based on candidate responses):`,
    ...role.seedQuestions.map((q, i) => `${i + 1}. ${q}`),
    "",
    "Five-stage interview progression:",
    "1. opening: Brief professional greeting, confirm readiness, short intro.",
    "2. technical_core: Core domain questions tailored to the target role.",
    "3. adaptive_deep_dive: Contextual follow-ups probing architecture, trade-offs, metrics, and edge cases from the candidate's answers.",
    "4. behavioral_scenario: Ownership, collaboration, and incident or ambiguity handling.",
    "5. wrap_up: Invite candidate questions, thank them, and close professionally.",
    "",
    "Conversation rules:",
    "- Ask one focused question at a time in 2 to 4 concise spoken sentences.",
    "- If interrupted mid-sentence, yield immediately and respond directly to the candidate's point.",
    "- Call advance_stage when transitioning stages or adapting difficulty based on candidate depth.",
    "- Call conclude_interview once closing remarks are finished.",
    "",
    isResume
      ? `RESUME STATE: Interview paused during "${session.currentStage}". Welcome the candidate back briefly and resume smoothly without repeating covered topics.\n\nPrior transcript:\n${priorTranscript}`
      : `Starting stage: ${session.currentStage}. Greet the candidate and ask your opening question.`,
  ].join("\n");
}

async function evaluateTranscript(
  session: InterviewSession,
  role: RoleTemplate
): Promise<CandidateEvaluation> {
  const candidateTurns = session.transcript.filter(
    (t) => t.speaker === "candidate" && t.text.trim().length > 0
  );
  if (candidateTurns.length === 0) {
    throw new Error("No candidate responses recorded to evaluate.");
  }

  const ai = getClient();
  const formatted = session.transcript
    .map(
      (t, idx) =>
        `${idx + 1}. [${t.timestamp}] [${t.stage}] ${
          t.speaker === "interviewer" ? "Interviewer" : session.candidateName
        }${t.interrupted ? " (interrupted)" : ""}: ${t.text}`
    )
    .join("\n");

  const response = await ai.models.generateContent({
    model: "gemini-4-hydrogen",
    contents: [
      `Role: ${role.title} (${session.seniority})`,
      `Candidate: ${session.candidateName}`,
      `Competencies: ${role.competencies.join(", ")}`,
      `Duration: ${session.elapsedSeconds}s | Interruptions: ${session.interruptionCount} | Resumes: ${session.resumeCount}`,
      "",
      "Produce an objective, evidence-backed candidate evaluation grounded strictly in the transcript below.",
      "",
      formatted,
    ].join("\n"),
    config: {
      systemInstruction:
        "You are a senior hiring panelist writing structured screening evaluations. Cite direct transcript evidence for each score.",
      responseMimeType: "application/json",
      responseSchema: {
        type: Type.OBJECT,
        properties: {
          overallScore: { type: Type.INTEGER },
          recommendation: { type: Type.STRING },
          executiveSummary: { type: Type.STRING },
          competencyScores: {
            type: Type.ARRAY,
            items: {
              type: Type.OBJECT,
              properties: {
                competency: { type: Type.STRING },
                score: { type: Type.INTEGER },
                rationale: { type: Type.STRING },
                evidenceQuote: { type: Type.STRING },
              },
              required: ["competency", "score", "rationale", "evidenceQuote"],
            },
          },
          strengths: { type: Type.ARRAY, items: { type: Type.STRING } },
          concerns: { type: Type.ARRAY, items: { type: Type.STRING } },
          questionBreakdown: {
            type: Type.ARRAY,
            items: {
              type: Type.OBJECT,
              properties: {
                topic: { type: Type.STRING },
                candidateSummary: { type: Type.STRING },
                depthRating: { type: Type.STRING },
                followUpEffectiveness: { type: Type.STRING },
              },
              required: [
                "topic",
                "candidateSummary",
                "depthRating",
                "followUpEffectiveness",
              ],
            },
          },
          nextRoundFocus: { type: Type.ARRAY, items: { type: Type.STRING } },
        },
        required: [
          "overallScore",
          "recommendation",
          "executiveSummary",
          "competencyScores",
          "strengths",
          "concerns",
          "questionBreakdown",
          "nextRoundFocus",
        ],
      },
    },
  });

  const text = (response.text ?? "").trim();
  if (!text) {
    throw new Error("Empty evaluation response.");
  }

  const parsed = JSON.parse(text) as Omit<CandidateEvaluation, "generatedAt">;
  return {
    ...parsed,
    overallScore: Math.max(0, Math.min(100, Math.round(parsed.overallScore))),
    generatedAt: new Date().toISOString(),
  };
}

