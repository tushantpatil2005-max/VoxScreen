const app = express();
const server = http.createServer(app);
const wss = new WebSocketServer({ noServer: true });

app.use(express.json({ limit: "2mb" }));

app.get("/", (_req, res) => {
  res.type("html").send(CLIENT_HTML);
});

app.get("/api/roles", (_req, res) => {
  res.json({ roles: loadStore().roles });
});

app.post("/api/roles", (req, res) => {
  const { title, department, seniority, summary, competencies, seedQuestions } =
    req.body ?? {};
  if (
    typeof title !== "string" ||
    !title.trim() ||
    !Array.isArray(competencies) ||
    competencies.length < 2
  ) {
    res.status(400).json({ error: "Provide a role title and at least two competencies." });
    return;
  }
  const store = loadStore();
  const role: RoleTemplate = {
    id: `role-${crypto.randomUUID().slice(0, 8)}`,
    title: title.trim(),
    department: typeof department === "string" && department.trim() ? department.trim() : "Engineering",
    seniority: seniority === "Mid-Level" || seniority === "Senior" || seniority === "Staff" ? seniority : "Senior",
    summary: typeof summary === "string" ? summary.trim() : "",
    competencies: competencies.map((c: unknown) => String(c).trim()).filter(Boolean),
    seedQuestions: Array.isArray(seedQuestions)
      ? seedQuestions.map((q: unknown) => String(q).trim()).filter(Boolean)
      : [],
  };
  store.roles.push(role);
  saveStore(store);
  res.status(201).json({ role });
});

app.get("/api/sessions", (_req, res) => {
  const store = loadStore();
  res.json({ sessions: store.sessions });
});

app.get("/api/sessions/:id", (req, res) => {
  const session = loadStore().sessions.find((s) => s.id === req.params.id);
  if (!session) {
    res.status(404).json({ error: "Session not found." });
    return;
  }
  res.json({ session });
});

app.post("/api/sessions", (req, res) => {
  const { candidateName, roleId, seniority, voiceName } = req.body ?? {};
  if (typeof candidateName !== "string" || !candidateName.trim()) {
    res.status(400).json({ error: "Candidate name is required." });
    return;
  }
  const store = loadStore();
  const role = store.roles.find((r) => r.id === roleId) ?? store.roles[0];
  const now = new Date().toISOString();
  const session: InterviewSession = {
    id: `int-${crypto.randomUUID().slice(0, 8)}`,
    candidateName: candidateName.trim(),
    roleId: role.id,
    roleTitle: role.title,
    seniority: typeof seniority === "string" && seniority.trim() ? seniority.trim() : role.seniority,
    voiceName: ["Kore", "Zephyr", "Puck", "Charon", "Fenrir"].includes(voiceName) ? voiceName : "Kore",
    status: "in_progress",
    currentStage: "opening",
    adaptationNotes: [],
    interruptionCount: 0,
    resumeCount: 0,
    elapsedSeconds: 0,
    createdAt: now,
    updatedAt: now,
    transcript: [],
    evaluation: null,
  };
  store.sessions.unshift(session);
  saveStore(store);
  res.status(201).json({ session });
});

app.post("/api/sessions/:id/evaluate", async (req, res) => {
  const store = loadStore();
  const session = store.sessions.find((s) => s.id === req.params.id);
  if (!session) {
    res.status(404).json({ error: "Session not found." });
    return;
  }
  const role = store.roles.find((r) => r.id === session.roleId) ?? store.roles[0];
  try {
    const evaluation = await evaluateTranscript(session, role);
    session.evaluation = evaluation;
    session.status = "completed";
    session.updatedAt = new Date().toISOString();
    saveStore(store);
    res.json({ session, evaluation });
  } catch (err) {
    res.status(500).json({
      error: err instanceof Error ? err.message : "Evaluation failed.",
    });
  }
});

server.on("upgrade", (req, socket, head) => {
  if ((req.url ?? "").split("?")[0] === "/ws/interview") {
    wss.handleUpgrade(req, socket, head, (ws) => wss.emit("connection", ws, req));
  }
});

wss.on("connection", (clientWs: WebSocket) => {
  let activeSessionId: string | null = null;
  let liveSession: Awaited<ReturnType<GoogleGenAI["live"]["connect"]>> | null = null;
  let pendingCandidate = "";
  let pendingInterviewer = "";

  const sendJson = (payload: Record<string, unknown>) => {
    if (clientWs.readyState === WebSocket.OPEN) {
      clientWs.send(JSON.stringify(payload));
    }
  };

  const commitTurn = (
    speaker: "interviewer" | "candidate",
    text: string,
    interrupted = false
  ) => {
    const clean = text.trim();
    if (!clean || !activeSessionId) return;
    const store = loadStore();
    const session = store.sessions.find((s) => s.id === activeSessionId);
    if (!session) return;
    const entry: TranscriptEntry = {
      id: `turn-${crypto.randomUUID().slice(0, 8)}`,
      speaker,
      text: clean,
      timestamp: new Date().toISOString(),
      stage: session.currentStage,
      interrupted,
    };
    session.transcript.push(entry);
    if (interrupted) session.interruptionCount += 1;
    session.updatedAt = new Date().toISOString();
    saveStore(store);
    sendJson({ type: "transcript_committed", entry });
  };

  const flushPending = (interrupted = false) => {
    if (pendingCandidate.trim()) {
      commitTurn("candidate", pendingCandidate, false);
      pendingCandidate = "";
    }
    if (pendingInterviewer.trim()) {
      commitTurn("interviewer", pendingInterviewer, interrupted);
      pendingInterviewer = "";
    }
  };

  const closeLive = () => {
    if (liveSession) {
      try {
        liveSession.close();
      } catch {
        // Ignore already closed
      }
      liveSession = null;
    }
  };

  clientWs.on("message", async (raw) => {
    let msg: {
      type?: string;
      sessionId?: string;
      resume?: boolean;
      audio?: string;
      text?: string;
      elapsedSeconds?: number;
    };
    try {
      msg = JSON.parse(raw.toString());
    } catch {
      return;
    }

    if (msg.type === "start" && msg.sessionId) {
      const store = loadStore();
      const session = store.sessions.find((s) => s.id === msg.sessionId);
      if (!session) {
        sendJson({ type: "error", message: "Session not found." });
        return;
      }
      const role = store.roles.find((r) => r.id === session.roleId) ?? store.roles[0];
      activeSessionId = session.id;
      session.status = "in_progress";
      if (msg.resume) session.resumeCount += 1;
      saveStore(store);
      closeLive();

      try {
        const ai = getClient();
        const conn = await ai.live.connect({
          model: "gemini-3.8-live",
          config: {
            responseModalities: [Modality.AUDIO],
            speechConfig: {
              voiceConfig: { prebuiltVoiceConfig: { voiceName: session.voiceName } },
            },
            inputAudioTranscription: {},
            outputAudioTranscription: {},
            systemInstruction: buildSystemPrompt(session, role, Boolean(msg.resume)),
            tools: [{ functionDeclarations: INTERVIEW_TOOLS }],
          },
          callbacks: {
            onopen: () => sendJson({ type: "ready", stage: session.currentStage }),
            onmessage: (message: LiveServerMessage) => {
              const content = message.serverContent;
              if (content?.inputTranscription?.text) {
                if (pendingInterviewer.trim()) {
                  commitTurn("interviewer", pendingInterviewer, false);
                  pendingInterviewer = "";
                }
                pendingCandidate += content.inputTranscription.text;
              }
              if (content?.outputTranscription?.text) {
                if (pendingCandidate.trim()) {
                  commitTurn("candidate", pendingCandidate, false);
                  pendingCandidate = "";
                }
                pendingInterviewer += content.outputTranscription.text;
              }
              for (const part of content?.modelTurn?.parts ?? []) {
                if (part.inlineData?.data) {
                  sendJson({ type: "audio", audio: part.inlineData.data });
                }
              }
              if (content?.interrupted) {
                if (pendingInterviewer.trim()) {
                  commitTurn("interviewer", pendingInterviewer, true);
                  pendingInterviewer = "";
                }
                sendJson({ type: "interrupted" });
              }
              if (content?.turnComplete && pendingInterviewer.trim()) {
                commitTurn("interviewer", pendingInterviewer, false);
                pendingInterviewer = "";
              }
              if (message.toolCall?.functionCalls?.length && liveSession) {
                const responses = message.toolCall.functionCalls.map((call) => {
                  if (call.name === "advance_stage") {
                    const args = (call.args ?? {}) as { stage?: string; adaptationNote?: string };
                    const next = VALID_STAGES.includes(args.stage as InterviewStage)
                      ? (args.stage as InterviewStage)
                      : session.currentStage;
                    const sStore = loadStore();
                    const s = sStore.sessions.find((item) => item.id === activeSessionId);
                    if (s) {
                      s.currentStage = next;
                      if (args.adaptationNote) s.adaptationNotes.push(args.adaptationNote);
                      saveStore(sStore);
                    }
                    sendJson({ type: "stage_updated", stage: next });
                  }
                  return { id: call.id, name: call.name, response: { ok: true } };
                });
                liveSession.sendToolResponse({ functionResponses: responses });
              }
            },
            onerror: (err: unknown) => {
              sendJson({
                type: "error",
                message: err instanceof Error ? err.message : "Live voice error.",
              });
            },
          },
        });
        liveSession = conn;
        liveSession.sendRealtimeInput({
          text: msg.resume
            ? `Candidate ${session.candidateName} has resumed the interview. Welcome them back briefly and continue.`
            : `Candidate ${session.candidateName} joined for ${role.title}. Begin with your greeting and first question.`,
        });
      } catch (err) {
        sendJson({
          type: "error",
          message: err instanceof Error ? err.message : "Failed to connect.",
        });
      }
    } else if (msg.type === "audio" && msg.audio && liveSession) {
      liveSession.sendRealtimeInput({
        audio: { data: msg.audio, mimeType: "audio/pcm;rate=16000" },
      });
    } else if (msg.type === "text" && msg.text && liveSession) {
      flushPending(false);
      commitTurn("candidate", msg.text, false);
      liveSession.sendRealtimeInput({ text: msg.text });
    } else if (msg.type === "manual_interrupt") {
      if (pendingInterviewer.trim()) {
        commitTurn("interviewer", pendingInterviewer, true);
        pendingInterviewer = "";
      }
      sendJson({ type: "interrupted" });
    } else if (msg.type === "pause") {
      flushPending(false);
      if (activeSessionId) {
        const store = loadStore();
        const s = store.sessions.find((item) => item.id === activeSessionId);
        if (s) {
          s.status = "paused";
          if (typeof msg.elapsedSeconds === "number") s.elapsedSeconds = msg.elapsedSeconds;
          saveStore(store);
        }
      }
      closeLive();
    } else if (msg.type === "finish") {
      flushPending(false);
      if (activeSessionId) {
        const store = loadStore();
        const s = store.sessions.find((item) => item.id === activeSessionId);
        if (s && typeof msg.elapsedSeconds === "number") {
          s.elapsedSeconds = msg.elapsedSeconds;
          saveStore(store);
        }
      }
      closeLive();
    }
  });

  clientWs.on("close", () => {
    flushPending(false);
    closeLive();
  });
});

const PORT = Number(process.env.PORT || 3001);
server.listen(PORT, "0.0.0.0", () => {
  console.log(`Voice Interview Agent running at http://localhost:${PORT}`);
});
